#!/usr/bin/env bash

set -euo pipefail

# Colors
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[0;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly RESET='\033[0m'
readonly BOLD='\033[1m'

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly DOTFILES_DIR
readonly GIT_EMAIL="quanghuynt14@gmail.com"
readonly SSH_KEY_PATH="${HOME}/.ssh/id_ed25519"

# Helpers

print_header() {
    echo -e "\n${BOLD}${BLUE}==>${RESET} ${BOLD}$1${RESET}"
}

print_success() {
    echo -e "${GREEN}✓${RESET} $1"
}

print_error() {
    echo -e "${RED}✗${RESET} $1" >&2
}

print_warning() {
    echo -e "${YELLOW}⚠${RESET} $1"
}

print_info() {
    echo -e "${CYAN}ℹ${RESET} $1"
}

command_exists() {
    command -v "$1" >/dev/null 2>&1
}

# The account's login shell: what chsh writes and what a new terminal starts.
# $SHELL only names the shell that launched this process, so a run from an
# editor, a cron job or an agent reports that parent instead.
login_shell() {
    local user
    user="$(id -un)"
    if [[ "$(uname -s)" == "Darwin" ]]; then
        dscl . -read "/Users/$user" UserShell 2>/dev/null | awk '{print $2}'
    else
        getent passwd "$user" 2>/dev/null | cut -d: -f7
    fi
}

setup_ssh_key() {
    if [[ -f "$SSH_KEY_PATH" && -f "${SSH_KEY_PATH}.pub" ]]; then
        print_success "SSH key already exists at $SSH_KEY_PATH"
    elif [[ -f "$SSH_KEY_PATH" ]]; then
        print_info "Regenerating missing public key from existing private key..."
        if ssh-keygen -y -f "$SSH_KEY_PATH" > "${SSH_KEY_PATH}.pub"; then
            print_success "SSH public key regenerated"
        else
            print_error "Failed to regenerate SSH public key"
            return 1
        fi
    else
        print_info "Generating SSH key for Git/GitHub..."
        mkdir -p "${HOME}/.ssh"
        chmod 700 "${HOME}/.ssh"

        if ssh-keygen -t ed25519 -C "$GIT_EMAIL" -f "$SSH_KEY_PATH" -N ""; then
            print_success "SSH key generated"
        else
            print_error "Failed to generate SSH key"
            return 1
        fi
    fi

    chmod 600 "$SSH_KEY_PATH" 2>/dev/null || true
    chmod 644 "${SSH_KEY_PATH}.pub" 2>/dev/null || true

    if command_exists ssh-add; then
        if ssh-add "$SSH_KEY_PATH" >/dev/null 2>&1; then
            print_success "SSH key added to ssh-agent"
        else
            print_warning "Could not add SSH key to ssh-agent"
        fi
    fi

    if command_exists pbcopy; then
        pbcopy < "${SSH_KEY_PATH}.pub"
        print_success "Public SSH key copied to clipboard"
    fi

    print_info "Add this public key to GitHub: Settings > SSH and GPG keys > New SSH key"
}

# Homebrew prefixes for the running platform, in preference order.
# Apple Silicon prefers /opt/homebrew (native); Intel macs prefer /usr/local;
# Linux uses linuxbrew. Other platforms get an empty list.
brew_candidates() {
    case "$(uname -s)" in
        Darwin)
            if [[ "$(uname -m)" == "arm64" ]]; then
                printf '%s\n' /opt/homebrew/bin/brew /usr/local/bin/brew
            else
                printf '%s\n' /usr/local/bin/brew /opt/homebrew/bin/brew
            fi
            ;;
        Linux)
            printf '%s\n' /home/linuxbrew/.linuxbrew/bin/brew
            ;;
    esac
}

# Trust gate for `eval $(brew shellenv)`: only run binaries owned by root or
# the current user. GNU stat (Linux) first, BSD stat (macOS) as fallback —
# reversing the order would cause GNU stat -f to dump filesystem info to
# stdout and contaminate the captured owner value.
brew_owner_is_safe() {
    local bin="$1" owner
    owner="$(stat -c %u "$bin" 2>/dev/null || stat -f %u "$bin" 2>/dev/null)"
    [[ -n "$owner" ]] || return 1
    [[ "$owner" == "0" || "$owner" == "$(id -u)" ]]
}

# Accept a brew already on PATH only if it resolves into a known prefix —
# guards against a shadowing binary or shell function getting eval'd.
brew_on_path_is_trusted() {
    local resolved
    resolved="$(command -v brew 2>/dev/null)" || return 1
    if command -v realpath >/dev/null 2>&1; then
        resolved="$(realpath "$resolved" 2>/dev/null || echo "$resolved")"
    fi
    case "$resolved" in
        /opt/homebrew/*|/home/linuxbrew/.linuxbrew/*|/usr/local/Homebrew/*|/usr/local/Cellar/*|/usr/local/bin/brew)
            return 0
            ;;
    esac
    return 1
}

# Source brew shellenv so brew (and everything it installed) is on PATH.
# Returns 0 only if a usable, trusted brew is on PATH afterwards.
ensure_brew_on_path() {
    if command_exists brew && brew_on_path_is_trusted; then
        return 0
    fi
    local candidate
    while IFS= read -r candidate; do
        [[ -x "$candidate" ]] || continue
        brew_owner_is_safe "$candidate" || continue
        eval "$("$candidate" shellenv)"
        command_exists brew && return 0
        return 1
    done < <(brew_candidates)
    return 1
}

# Run the skills CLI through fish, so it uses the same npx (and nvm-managed
# Node) an interactive shell would. '-y' is the skills CLI's own flag; without
# it the CLI waits on a confirmation prompt and hangs when stdout is not a TTY
# ('npx --yes' only covers npx itself). $1 is the headline printed above the
# captured output on failure, so a failure says why instead of just warning.
run_skills_cli() {
    local headline="$1"
    shift

    # GNU mktemp's '-t' takes a template and rejects one without X's, while
    # BSD's takes a bare prefix, so pass an explicit path that suits both.
    local log
    log="$(mktemp "${TMPDIR:-/tmp}/skills-cli.XXXXXX")"

    if fish -c "npx --yes skills $*" >"$log" 2>&1 </dev/null; then
        rm -f "$log"
        return 0
    fi

    print_warning "$headline"
    # The CLI draws spinners, so strip escape codes and keep the tail, where
    # the actual error lands. '|| true' because pipefail would otherwise abort
    # the caller when grep filters everything out.
    {
        if command_exists perl; then
            perl -pe 's/\e\[[0-9;?]*[a-zA-Z]//g; s/\r/\n/g' "$log"
        else
            cat "$log"
        fi
    } | grep -v '^[[:space:]]*$' | tail -15 | sed 's/^/    /' >&2 || true
    rm -f "$log"
    return 1
}

# Global agent skills are installed by the skills CLI (see cmd_init) and
# versioned under ~/.agents/skills; nothing in this repo pins them, so refresh
# them all here rather than updating each one by hand.
update_global_skills() {
    if ! command_exists fish; then
        print_warning "fish not found; skipped updating global agent skills"
        return 0
    fi

    print_info "Updating global agent skills..."
    if run_skills_cli "Failed to update global agent skills:" update -g -y; then
        print_success "Global agent skills updated"
    else
        print_info "Retry manually: npx skills update -g -y"
    fi
}

# Start Colima if it isn't already running. Colima hosts the Docker daemon on
# this machine (no Docker Desktop), and the Testcontainers-based integration
# tests need it. Resource flags only apply on the first start: after that they
# live in ~/.colima/default/colima.yaml and changing them needs a restart.
ensure_colima_running() {
    if [[ "$(uname -s)" != "Darwin" ]]; then
        return 0
    fi

    if ! command_exists colima; then
        print_warning "colima not found; skipped starting the container runtime"
        return 0
    fi

    if colima status >/dev/null 2>&1; then
        print_success "Colima is already running"
        return 0
    fi

    print_info "Starting Colima (first start builds the VM, takes a minute)..."
    # vz + virtiofs are the native macOS 13+ backends: faster than the QEMU
    # default, and virtiofs is what makes bind mounts usable.
    if colima start --cpu 4 --memory 8 --disk 60 --vm-type=vz --mount-type=virtiofs; then
        print_success "Colima started"
    else
        print_warning "Failed to start Colima"
        print_info "Retry manually: colima start"
        return 0
    fi
}

# Backup conflicting files then stow

stow_dotfiles() {
    local home_dir="${DOTFILES_DIR}/home"
    local backup_dir="${DOTFILES_DIR}/backups/$(date +%Y%m%d_%H%M%S)"
    local has_conflicts=false

    # Find files that would conflict with stow
    while IFS= read -r -d '' file; do
        local relative="${file#"${home_dir}"/}"
        local target="${HOME}/${relative}"

        # Skip if the target is reached via a stow-folded parent symlink
        # (the leaf isn't a symlink, but it resolves into the dotfiles repo).
        if [[ -e "$target" && ! -L "$target" ]]; then
            local resolved
            resolved="$(realpath "$target" 2>/dev/null || readlink -f "$target" 2>/dev/null || echo "$target")"
            if [[ "$resolved" == "${home_dir}"/* ]]; then
                continue
            fi
            has_conflicts=true
            mkdir -p "$(dirname "${backup_dir}/${relative}")"
            cp -p "$target" "${backup_dir}/${relative}"
            print_warning "Conflict detected: $target exists. Back it up manually."
        fi
    done < <(find "$home_dir" -type f -print0)

    if [[ "$has_conflicts" == true ]]; then
        print_info "Backed up conflicting files to ${backup_dir}"
    fi

    if stow -R -d "${DOTFILES_DIR}" -t "${HOME}" home; then
        print_success "Dotfiles stowed successfully"
    else
        print_error "Failed to stow dotfiles"
        return 1
    fi
}

# Google Chrome, driven headlessly by the chrome-devtools MCP server so agents
# can load a page and read its console, network and performance data.
#
# The Google .deb is deliberate over the Chrome that Playwright or Puppeteer
# downloads. Those tarballs unpack a binary with no dependency resolution — on
# a fresh Ubuntu server it fails to start on ~20 missing shared libraries
# (libnspr4, libnss3, libgbm1, ...) that apt pulls in automatically here.
# The .deb also lands the binary at /opt/google/chrome/chrome, the exact path
# Ubuntu 24.04's stock /etc/apparmor.d/chrome profile grants 'userns' to; a
# browser installed anywhere else is unconfined, and with the 24.04 default of
# kernel.apparmor_restrict_unprivileged_userns=1 it cannot build its sandbox
# and would have to run with --no-sandbox. Finally, the .deb registers Google's
# apt repo on install, so Chrome updates with the rest of the system.
install_chrome() {
    # macOS gets Chrome from the Brewfile cask alongside the other GUI apps.
    if [[ "$(uname -s)" == "Darwin" ]]; then
        return 0
    fi

    if [[ -x /opt/google/chrome/chrome ]]; then
        print_success "Google Chrome is already installed"
        return 0
    fi

    if ! command_exists apt-get; then
        print_warning "Not an apt-based system; install Google Chrome manually for browser testing"
        return 1
    fi

    # Google publishes no Linux .deb for arm64.
    if [[ "$(uname -m)" != "x86_64" ]]; then
        print_warning "Google Chrome has no Linux build for $(uname -m); skipping browser testing setup"
        return 1
    fi

    print_info "Installing Google Chrome (requires sudo)..."

    # A temp directory rather than a temp file: apt-get needs the argument to
    # look like a package path, and giving mktemp a '.deb' suffix is a GNU-only
    # extension that BSD mktemp rejects.
    local tmpdir deb
    tmpdir="$(mktemp -d "${TMPDIR:-/tmp}/chrome-install.XXXXXX")"
    deb="${tmpdir}/google-chrome-stable_current_amd64.deb"

    # Dependencies come from the apt lists, which are usually stale on a fresh
    # remote; without a refresh the install fails on unresolvable versions.
    sudo apt-get update -qq || true

    if curl -fsSL -o "$deb" https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
        && sudo apt-get install -y "$deb"; then
        print_success "Google Chrome installed"
        rm -rf "$tmpdir"
    else
        print_warning "Failed to install Google Chrome"
        rm -rf "$tmpdir"
        return 1
    fi
}

# Register the chrome-devtools MCP server with Claude Code at user scope, so
# every project on the box gets it. Skills that need a real browser
# (agent-skills' browser-testing-with-devtools, cloudflare's web-perf) drive
# this server and do nothing without it.
#
# The registration lives in ~/.claude.json — machine-local state this repo
# doesn't stow — so the flags below are the source of truth: drop any existing
# entry first, and editing them here lands on the next 'run init' instead of
# being silently ignored because the name was already taken.
setup_browser_mcp() {
    local claude_bin
    if command_exists claude; then
        claude_bin="claude"
    elif [[ -x "${HOME}/.local/bin/claude" ]]; then
        # Installed a step ago by the native installer; this shell's PATH
        # predates it.
        claude_bin="${HOME}/.local/bin/claude"
    else
        print_warning "Claude Code not found; skipped the chrome-devtools MCP server"
        return 1
    fi

    local -a server_args=(
        -y chrome-devtools-mcp@latest
        # Use the Chrome installed above rather than downloading a second one.
        --channel stable
        # A throwaway profile per session, so parallel agents don't contend for
        # one profile's lock file. Drop it if an agent needs to stay signed in
        # to an app between sessions.
        --isolated
    )
    # These are SSH boxes with no display; only macOS has one to draw into.
    if [[ "$(uname -s)" != "Darwin" ]]; then
        server_args+=(--headless)
    fi

    # 'remove' exits non-zero when the server isn't registered yet, which is the
    # normal first-run case, so don't let it abort init under 'set -e'.
    "$claude_bin" mcp remove -s user chrome-devtools >/dev/null 2>&1 || true

    if "$claude_bin" mcp add -s user chrome-devtools -- npx "${server_args[@]}" >/dev/null; then
        print_success "chrome-devtools MCP server registered"
    else
        print_warning "Failed to register the chrome-devtools MCP server"
        return 1
    fi

    # Warm npx's cache. Claude Code gives an MCP server a bounded startup
    # window, and a cold 'npx -y' downloading the package inside that window can
    # miss it — leaving the first browser request of a fresh box failing for a
    # reason that looks nothing like a download. Run it through fish, because
    # nvm.fish owns the Node version and bash here may have no npx at all.
    print_info "Warming the chrome-devtools MCP cache..."
    if fish -c 'npx --yes chrome-devtools-mcp@latest --version' >/dev/null 2>&1; then
        print_success "chrome-devtools MCP cache warmed"
    else
        print_warning "Could not pre-fetch chrome-devtools-mcp; it will download on first use"
    fi
}

# Commands

cmd_init() {
    print_header "Initializing dotfiles"

    # 1. Homebrew
    if command_exists brew; then
        print_success "Homebrew is already installed"
    else
        print_info "Installing Homebrew..."
        if NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"; then
            if ! ensure_brew_on_path; then
                print_error "Homebrew installed but brew binary not found in known prefixes"
                return 1
            fi
            print_success "Homebrew installed"
        else
            print_error "Failed to install Homebrew"
            return 1
        fi
    fi

    # 2. Packages
    print_info "Installing packages from Brewfile..."
    if brew bundle --file="${DOTFILES_DIR}/Brewfile"; then
        print_success "All packages installed"
    else
        print_warning "Some packages failed to install"
    fi

    # Unlink Homebrew's node so nvm.fish controls the Node version
    if brew ls --versions node >/dev/null 2>&1; then
        brew unlink node >/dev/null 2>&1
        print_success "Unlinked Homebrew node (managed by nvm instead)"
    fi

    # 3. Stow
    print_info "Stowing dotfiles..."
    stow_dotfiles

    # 4. SSH key for Git/GitHub and SSH commit signing
    setup_ssh_key

    # 5. Fish as default shell
    local fish_path
    fish_path="$(command -v fish)"

    if ! grep -q "$fish_path" /etc/shells 2>/dev/null; then
        print_info "Adding Fish to /etc/shells (requires sudo)..."
        echo "$fish_path" | sudo tee -a /etc/shells >/dev/null
    fi

    if [[ "$(login_shell)" != "$fish_path" ]]; then
        print_info "Setting Fish as default shell..."
        if chsh -s "$fish_path"; then
            print_success "Default shell changed to Fish"
        else
            print_error "Failed to change default shell"
        fi
    else
        print_success "Fish is already the default shell"
    fi

    # 6. Fisher & plugins (Fish plugin manager)
    print_info "Installing Fisher & updating Fish plugins..."
    fish -c '
    # Install Fisher if not installed
    if not functions -q fisher
        curl -sL https://git.io/fisher | source
    end
    
    # Update plugins
    fisher update
    '
    print_success "Fisher & Fish plugins updated"

    # 7. Clean up universal variables that conflict with conf.d settings.
    #    'set --erase' returns non-zero when the variable doesn't exist; without
    #    the '|| true' guard that would abort the whole script under 'set -e'
    #    before the remaining init steps (Node, Claude Code) ever run.
    fish -c 'set --erase --universal nvm_default_version' 2>/dev/null || true
    fish -c 'set --erase --universal PATH' 2>/dev/null || true
    print_success "Cleaned up universal Fish variables"

    # 8. Remove stale system-level Node binaries (e.g. from old pkg installers)
    for bin in node npm npx; do
        if [ -f "/usr/local/bin/$bin" ]; then
            sudo rm "/usr/local/bin/$bin"
        fi
    done
    print_success "Removed stale system Node binaries (if any)"

    # 9. Install the default Node version so nvm.fish's startup guard doesn't
    #    error with "version must be installed first" on the next shell launch.
    local node_version
    node_version="$(fish -c 'echo -n $nvm_default_version' 2>/dev/null)"
    print_info "Installing default Node version (${node_version:-unknown}) via nvm..."
    if fish -c '
        if not functions -q nvm
            exit 1
        end
        test -n "$nvm_default_version"; or exit 1
        nvm install $nvm_default_version
    '; then
        print_success "Default Node version (${node_version:-unknown}) installed"
    else
        print_warning "Could not install default Node version (${node_version:-unknown}) via nvm"
    fi

    # 10. Install Claude Code via the recommended native installer (not Homebrew),
    #     so it self-updates and doesn't depend on Node/npm.
    if command_exists claude; then
        print_success "Claude Code is already installed"
    else
        print_info "Installing Claude Code (native installer)..."
        if curl -fsSL https://claude.ai/install.sh | bash; then
            print_success "Claude Code installed"
        else
            print_warning "Failed to install Claude Code"
        fi
    fi

    # 11. Herdr agent integration and skill. Both files are owned and versioned
    #      upstream (herdr ships the hook, the skills CLI fetches the skill from
    #      GitHub), so install them here rather than vendoring copies that would
    #      silently go stale. Both commands are idempotent.
    if command_exists herdr; then
        print_info "Installing Herdr's Claude Code integration..."
        if herdr integration install claude >/dev/null; then
            print_success "Herdr Claude Code integration installed"
        else
            print_warning "Failed to install Herdr's Claude Code integration"
        fi

        print_info "Installing the Herdr agent skill..."
        if run_skills_cli "Failed to install the Herdr agent skill:" \
            add herdrdev/herdr --skill herdr -g -y; then
            print_success "Herdr agent skill installed"
        else
            print_info "Retry manually: npx skills add herdrdev/herdr --skill herdr -g -y"
        fi
    else
        print_warning "herdr not found; skipped its integration and skill"
    fi

    # 12. Container runtime for Docker-based tooling (Testcontainers, compose).
    ensure_colima_running

    # 13. Browser testing: a real Chrome plus the chrome-devtools MCP server
    #      that agents drive it through. Neither step is fatal — a box without a
    #      browser is still a usable dev box — so keep going on failure.
    install_chrome && setup_browser_mcp || true

    print_header "Done! Open a new terminal to see your new prompt."
}

cmd_stow() {
    print_header "Stowing dotfiles"
    stow_dotfiles
}

cmd_update() {
    print_header "Updating dotfiles"

    print_info "Pulling latest changes..."
    if git -C "$DOTFILES_DIR" pull; then
        print_success "Repository updated"
    else
        print_error "Failed to pull"
        return 1
    fi

    stow_dotfiles

    update_global_skills
}

cmd_doctor() {
    print_header "Running diagnostics"

    ensure_brew_on_path || true

    local issues=0

    # Homebrew
    if command_exists brew; then
        print_success "Homebrew installed"
    else
        local found=""
        while IFS= read -r candidate; do
            if [[ -x "$candidate" ]]; then
                found="$candidate"
                break
            fi
        done < <(brew_candidates)
        if [[ -n "$found" ]]; then
            print_error "Homebrew at $found exists but cannot bootstrap PATH"
            print_info "  Verify ownership (you or root) and that 'brew shellenv' produces valid output"
        else
            print_error "Homebrew not installed"
        fi
        ((++issues))
    fi

    # Check Brewfile packages
    if command_exists brew && [[ -f "${DOTFILES_DIR}/Brewfile" ]]; then
        if brew bundle check --file="${DOTFILES_DIR}/Brewfile" >/dev/null 2>&1; then
            print_success "All Brewfile packages installed"
        else
            print_warning "Some Brewfile packages are missing"
            local bundle_check_output
            bundle_check_output="$(brew bundle check --file="${DOTFILES_DIR}/Brewfile" 2>&1 || true)"
            while IFS= read -r line; do
                print_info "  $line"
            done <<< "$bundle_check_output"
        fi
    fi

    # Stow
    if command_exists stow; then
        print_success "GNU Stow installed"
    else
        print_error "GNU Stow not installed"
        ((++issues))
    fi

    # Fish
    if command_exists fish; then
        print_success "Fish shell installed"
        local current_shell
        current_shell="$(login_shell)"
        if [[ "$current_shell" == "$(command -v fish)" ]]; then
            print_success "Fish is default shell"
        else
            print_warning "Fish is not default shell (current: ${current_shell:-unknown})"
        fi
    else
        print_error "Fish shell not installed"
        ((++issues))
    fi

    # Container runtime. On macOS the daemon lives in Colima; elsewhere it is
    # native, so only its reachability is worth checking.
    if [[ "$(uname -s)" == "Darwin" ]]; then
        if ! command_exists colima; then
            print_warning "Colima not installed; Testcontainers tests will fail"
        elif colima status >/dev/null 2>&1; then
            print_success "Colima running"
        else
            print_warning "Colima installed but not running (run: colima start)"
        fi
    fi

    if ! command_exists docker; then
        print_warning "No docker CLI; Testcontainers tests will fail"
    elif docker info >/dev/null 2>&1; then
        print_success "Docker daemon reachable"
    else
        print_warning "Docker CLI cannot reach a daemon (check DOCKER_HOST)"
    fi

    # Starship
    if command_exists starship; then
        print_success "Starship prompt installed"
    else
        print_error "Starship not installed"
        ((++issues))
    fi

    # Ghostty (terminal emulator — skip on headless Linux)
    if [[ "$(uname -s)" == "Darwin" ]]; then
        if [[ -d "/Applications/Ghostty.app" ]]; then
            print_success "Ghostty installed"
        else
            print_warning "Ghostty not found in /Applications"
        fi
    elif [[ -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" ]]; then
        if command_exists ghostty; then
            print_success "Ghostty installed"
        else
            print_warning "Ghostty not found on PATH"
        fi
    fi

    # Browser testing (Chrome + the MCP server agents drive it through)
    if [[ "$(uname -s)" == "Darwin" ]]; then
        if [[ -d "/Applications/Google Chrome.app" ]]; then
            print_success "Google Chrome installed"
        else
            print_warning "Google Chrome not found in /Applications"
        fi
    elif [[ -x /opt/google/chrome/chrome ]]; then
        print_success "Google Chrome installed"
    else
        print_warning "Google Chrome not installed (browser testing unavailable)"
        print_info "  Run './run init' to install it"
    fi

    if command_exists claude; then
        if claude mcp get chrome-devtools >/dev/null 2>&1; then
            print_success "chrome-devtools MCP server registered"
        else
            print_warning "chrome-devtools MCP server not registered"
            print_info "  Run './run init' to register it"
        fi
    fi

    # Key symlinks
    local expected_links=(
        ".config/fish/config.fish"
        ".config/ghostty/config"
        ".config/git/config"
        ".config/starship.toml"
        ".config/fish/conf.d/docker.fish"
    )

    local broken=0
    for link in "${expected_links[@]}"; do
        local target="${HOME}/${link}"
        if [[ -L "$target" ]]; then
            if [[ -e "$target" ]]; then
                print_success "Symlink OK: ~/${link}"
            else
                print_error "Broken symlink: ~/${link}"
                ((++broken))
            fi
        elif [[ -e "$target" ]] && [[ "$(realpath "$target")" == "${DOTFILES_DIR}"/* ]]; then
            # File exists and resolves into dotfiles (via symlinked parent dir)
            print_success "Managed by dotfiles: ~/${link}"
        else
            print_warning "Not managed by dotfiles: ~/${link}"
            ((++broken))
        fi
    done

    # Git config location
    if [[ -f "${HOME}/.gitconfig" ]]; then
        print_warning "~/.gitconfig exists (may override ~/.config/git/config)"
    fi

    # SSH key used by Git signing config
    if [[ -f "$SSH_KEY_PATH" && -f "${SSH_KEY_PATH}.pub" ]]; then
        print_success "SSH signing key exists"
    else
        print_warning "SSH signing key missing at $SSH_KEY_PATH"
        print_info "  Run './run init' to generate it"
        ((++issues))
    fi

    echo ""
    if [[ $issues -eq 0 && $broken -eq 0 ]]; then
        print_success "All checks passed!"
    else
        print_warning "Found $issues critical issues, $broken symlink issues"
    fi
}

cmd_help() {
    echo -e "${BOLD}Usage:${RESET} run <command>"
    echo ""
    echo -e "${BOLD}Commands:${RESET}"
    echo "    init      Full setup: Homebrew, packages, stow, SSH key, Fish, browser testing"
    echo "    stow      Backup conflicts and re-stow dotfiles"
    echo "    update    Pull latest changes, re-stow, update global agent skills"
    echo "    doctor    Run diagnostics"
    echo "    help      Show this message"
}

# Main

case "${1:-help}" in
    init)   cmd_init ;;
    stow)   cmd_stow ;;
    update) cmd_update ;;
    doctor) cmd_doctor ;;
    help)   cmd_help ;;
    *)
        print_error "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
